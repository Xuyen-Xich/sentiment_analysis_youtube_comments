__pycache__/
.pytest_cache/
profiles/
*.pyc
**/.venv/

# Giữ cấu trúc thư mục data nhưng bỏ qua tệp bên trong
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Giữ cấu trúc thư mục outputs nhưng bỏ qua tệp bên trong
outputs/figures/*
!outputs/figures/.gitkeep

outputs/metrics/*
!outputs/metrics/.gitkeep

outputs/models/*
!outputs/models/.gitkeep
